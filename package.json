{
	"name": "etch",
	"version": "0.1.0",
	"description": "A daily learning log with spaced-repetition reviews and a planner.",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run format:check && npm run typecheck && npm run lint",
		"generate-reviews": "tsx src/scripts/generate-reviews.ts",
		"dev:server": "tsx watch src/server/index.ts",
		"start": "tsx watch src/server/index.ts --production"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-java": "^6.0.2",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/language": "^6.13.1",
		"@codemirror/legacy-modes": "^6.5.5",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@hono/node-server": "^2.1.5",
		"@hono/zod-validator": "^0.9.1",
		"@lezer/highlight": "^1.2.5",
		"@uiw/react-codemirror": "^4.25.12",
		"d3-force": "^3.0.0",
		"hono": "^4.13.14",
		"lucide-react": "^1.64.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"concurrently": "^10.0.6",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
